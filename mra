#!/usr/bin/env bash
# ==============================================================================
# mra - MacRemote Agent CLI Controller
# Universal Apple Silicon Management Tool (M1, M2, M3, M4)
# ==============================================================================

set -e

# Resolve script directory (follows symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"

# Identify active repo directory
if [ -f "$SCRIPT_DIR/agent.py" ]; then
    REPO_DIR="$SCRIPT_DIR"
elif [ -n "$MRA_DIR" ] && [ -f "$MRA_DIR/agent.py" ]; then
    REPO_DIR="$MRA_DIR"
elif [ -f "/Users/sddsd/mac-remote-agent-1/agent.py" ]; then
    REPO_DIR="/Users/sddsd/mac-remote-agent-1"
elif [ -f "$HOME/mac-remote-agent/agent.py" ]; then
    REPO_DIR="$HOME/mac-remote-agent"
else
    echo "❌ Error: Could not locate MacRemote Agent directory (agent.py)."
    exit 1
fi

PID_FILE="$REPO_DIR/agent.pid"
LOG_FILE="$REPO_DIR/agent.log"
CONFIG_FILE="$REPO_DIR/config.json"
PYTHON_BIN="$(which python3)"

# Color definitions
BOLD="\033[1m"
GREEN="\033[0;32m"
RED="\033[0;31m"
YELLOW="\033[0;33m"
CYAN="\033[0;36m"
BLUE="\033[0;34m"
RESET="\033[0m"

# Ensure ~/.local/bin/mra symlink exists
ensure_symlink() {
    local target_dir="$HOME/.local/bin"
    mkdir -p "$target_dir"
    local symlink_path="$target_dir/mra"
    if [ ! -L "$symlink_path" ] && [ ! -f "$symlink_path" ]; then
        ln -sf "$REPO_DIR/mra" "$symlink_path" 2>/dev/null || true
    fi
}
ensure_symlink

get_agent_pid() {
    if [ -f "$PID_FILE" ]; then
        local pid
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && ps -p "$pid" > /dev/null 2>&1; then
            echo "$pid"
            return
        fi
    fi
    local pids
    pids=$(pgrep -f "agent\.py" || true)
    if [ -n "$pids" ]; then
        echo "$pids" | head -n 1
    fi
}

cmd_status() {
    local pid
    pid=$(get_agent_pid)
    local chip
    chip=$(sysctl -n machdep.cpu.brand_string 2>/dev/null || echo "Apple Silicon")
    
    echo -e "${BOLD}==============================================================${RESET}"
    echo -e "${CYAN}${BOLD}    🚀 MacRemote Agent — Status Dashboard${RESET}"
    echo -e "${BOLD}==============================================================${RESET}"
    echo -e "Hardware:   ${BOLD}$chip${RESET}"
    
    if [ -n "$pid" ]; then
        echo -e "Service:    ${GREEN}${BOLD}🟢 RUNNING${RESET} (PID: ${BOLD}$pid${RESET})"
    else
        echo -e "Service:    ${RED}${BOLD}🔴 STOPPED${RESET}"
    fi

    # Battery & AC power
    local batt
    batt=$(pmset -g batt 2>/dev/null || true)
    if echo "$batt" | grep -q "AC Power"; then
        echo -e "Power:      ${GREEN}🔌 AC Power (Plugged in)${RESET}"
    else
        echo -e "Power:      ${YELLOW}🔋 Battery Mode${RESET}"
    fi
    local pct
    pct=$(echo "$batt" | grep -o "[0-9]*%" | head -n 1 || echo "")
    if [ -n "$pct" ]; then
        echo -e "Battery:    ${BOLD}$pct${RESET}"
    fi

    # Config info
    if [ -f "$CONFIG_FILE" ]; then
        local pin
        pin=$(grep -o '"pairing_pin": *"[^"]*"' "$CONFIG_FILE" | cut -d'"' -f4 || echo "")
        local users_count
        users_count=$(grep -o '"allowed_user_ids": *\[[^]]*\]' "$CONFIG_FILE" | grep -o '[0-9]\+' | wc -l | tr -d ' ' || echo "0")
        echo -e "Pairing PIN:${BOLD} ${YELLOW}$pin${RESET}"
        echo -e "Authorized: ${BOLD}$users_count device(s)${RESET}"
    fi

    echo -e "${BOLD}--------------------------------------------------------------${RESET}"
    if [ -f "$LOG_FILE" ]; then
        echo -e "${BOLD}Recent Logs (last 5 lines):${RESET}"
        tail -n 5 "$LOG_FILE" | sed 's/^/  /'
    fi
    echo -e "${BOLD}==============================================================${RESET}"
}

cmd_start() {
    local pid
    pid=$(get_agent_pid)
    if [ -n "$pid" ]; then
        echo -e "${YELLOW}⚠️ MacRemote Agent is already running (PID: $pid).${RESET}"
        return 0
    fi

    echo -e "${CYAN}Starting MacRemote Agent in background...${RESET}"
    cd "$REPO_DIR"
    nohup "$PYTHON_BIN" "$REPO_DIR/agent.py" < /dev/null >> "$LOG_FILE" 2>&1 &
    local new_pid=$!
    echo "$new_pid" > "$PID_FILE"
    sleep 1

    if ps -p "$new_pid" > /dev/null 2>&1; then
        echo -e "${GREEN}✅ MacRemote Agent started successfully (PID: $new_pid).${RESET}"
        echo -e "Closing this terminal will ${BOLD}not${RESET} stop the agent."
        echo -e "To view logs:  ${CYAN}mra logs${RESET}"
        echo -e "To stop:       ${CYAN}mra stop${RESET}"
    else
        echo -e "${RED}❌ Failed to start. Check logs:${RESET}"
        tail -n 10 "$LOG_FILE"
        exit 1
    fi
}

cmd_stop() {
    echo -e "${CYAN}Stopping MacRemote Agent and shutting down all subshells...${RESET}"
    
    # Kill caffeinate child processes
    pkill -f "caffeinate -s -i -m" 2>/dev/null || true

    local pid
    pid=$(get_agent_pid)
    if [ -n "$pid" ]; then
        kill "$pid" 2>/dev/null || true
        for _ in {1..10}; do
            if ! ps -p "$pid" > /dev/null 2>&1; then
                break
            fi
            sleep 0.2
        done
        if ps -p "$pid" > /dev/null 2>&1; then
            kill -9 "$pid" 2>/dev/null || true
        fi
    fi

    # Kill any leftover agent.py
    local extra_pids
    extra_pids=$(pgrep -f "agent\.py" || true)
    if [ -n "$extra_pids" ]; then
        kill -9 $extra_pids 2>/dev/null || true
    fi

    # Final cleanup of caffeinate
    pkill -f "caffeinate -s -i -m" 2>/dev/null || true
    rm -f "$PID_FILE"
    echo -e "${GREEN}✅ MacRemote Agent completely stopped.${RESET}"
}

cmd_restart() {
    cmd_stop
    sleep 1
    cmd_start
}

cmd_run() {
    local pid
    pid=$(get_agent_pid)
    if [ -n "$pid" ]; then
        echo -e "${YELLOW}⚠️ Another instance is running (PID: $pid). Stopping it first...${RESET}"
        cmd_stop
        sleep 1
    fi

    echo -e "${CYAN}${BOLD}Running MacRemote Agent in foreground (interactive mode)...${RESET}"
    echo -e "Note: When you close this terminal or press Ctrl+C, the agent and its shells will shut down cleanly."
    echo ""
    cd "$REPO_DIR"
    exec "$PYTHON_BIN" "$REPO_DIR/agent.py"
}

cmd_logs() {
    if [ ! -f "$LOG_FILE" ]; then
        touch "$LOG_FILE"
    fi
    echo -e "${CYAN}Streaming logs from $LOG_FILE (Press Ctrl+C to exit):${RESET}"
    tail -f "$LOG_FILE"
}

cmd_pin() {
    if [ -f "$CONFIG_FILE" ]; then
        local pin
        pin=$(grep -o '"pairing_pin": *"[^"]*"' "$CONFIG_FILE" | cut -d'"' -f4 || echo "Unknown")
        echo -e "${BOLD}🔑 MacRemote Pairing PIN:${RESET} ${GREEN}${BOLD}$pin${RESET}"
        echo -e "To pair your phone, send this to your bot in Telegram:"
        echo -e "   ${CYAN}${BOLD}/pair $pin${RESET}"
    else
        echo -e "${RED}config.json not found.${RESET}"
    fi
}

cmd_help() {
    echo -e "${BOLD}Usage:${RESET} mra [command]"
    echo ""
    echo -e "${BOLD}Commands:${RESET}"
    echo -e "  ${CYAN}mra${RESET}               Show status dashboard and quick actions"
    echo -e "  ${CYAN}mra start${RESET}         Start agent in background (detached from terminal)"
    echo -e "  ${CYAN}mra stop${RESET}          Stop agent & shut down all shells and caffeinate"
    echo -e "  ${CYAN}mra restart${RESET}       Restart agent cleanly"
    echo -e "  ${CYAN}mra run${RESET}           Run in foreground (closes cleanly when terminal closes)"
    echo -e "  ${CYAN}mra status${RESET}        Check agent and power status"
    echo -e "  ${CYAN}mra logs${RESET}          View real-time logs (tail -f)"
    echo -e "  ${CYAN}mra pin${RESET}           Show pairing PIN & pairing command"
    echo -e "  ${CYAN}mra service${RESET}       Manage macOS 24/7 background LaunchAgent"
    echo -e "  ${CYAN}mra help${RESET}          Show this help message"
    echo ""
}

cmd_service() {
    local action="${1:-status}"
    case "$action" in
        install)
            "$REPO_DIR/install-service.sh"
            ;;
        uninstall)
            "$REPO_DIR/uninstall-service.sh"
            ;;
        status)
            launchctl list | grep -i "com.antigravity.macremote" || echo "LaunchAgent not loaded."
            ;;
        *)
            echo "Usage: mra service [install|uninstall|status]"
            ;;
    esac
}

# Main command router
ACTION="${1:-}"
case "$ACTION" in
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    run)
        cmd_run
        ;;
    status)
        cmd_status
        ;;
    log|logs)
        cmd_logs
        ;;
    pin|pair)
        cmd_pin
        ;;
    service)
        shift
        cmd_service "$@"
        ;;
    help|--help|-h)
        cmd_help
        ;;
    "")
        cmd_status
        echo ""
        echo -e "Quick Actions: [${CYAN}mra start${RESET}] [${CYAN}mra stop${RESET}] [${CYAN}mra restart${RESET}] [${CYAN}mra run${RESET}] [${CYAN}mra logs${RESET}] [${CYAN}mra pin${RESET}]"
        ;;
    *)
        echo -e "${RED}Unknown command: $ACTION${RESET}"
        cmd_help
        exit 1
        ;;
esac
